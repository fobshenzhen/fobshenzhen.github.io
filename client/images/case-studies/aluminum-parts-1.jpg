<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 Page Not Found</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #ffffff;
            color: #333333;
        }

        .error-page {
            text-align: center;
            padding: 2rem;
            max-width: 800px;
            width: 100%;
        }

        .ufo-icon {
            font-size: 4rem;
            color: #555555;
            margin-bottom: 2rem;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .error-code {
            position: relative;
            font-size: 20vw;
            font-weight: 900;
            color: #f0f0f0;
            margin-bottom: -10vw;
            z-index: 0;
            user-select: none;
        }

        .error-title {
            position: relative;
            z-index: 1;
            font-size: 3.5rem;
            font-weight: 700;
            color: #165DFF;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .error-desc {
            font-size: 1.25rem;
            line-height: 1.6;
            color: #333333;
            margin-bottom: 1rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* 倒计时文字 */
        .countdown-text {
            font-size: 1rem;
            color: #666;
            margin-bottom: 2rem;
        }

        .countdown-text strong {
            color: #165DFF;
            font-size: 1.1rem;
        }

        .error-buttons {
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .error-btn {
            padding: 1rem 2.2rem;
            background-color: #165DFF;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            transition: all 0.2s ease;
            border: none;
            cursor: pointer;
        }

        .error-btn:hover {
            background-color: #0d47a1;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(22, 93, 255, 0.3);
        }

        @media (max-width: 768px) {
            .error-title {
                font-size: 2.2rem;
            }

            .error-desc {
                font-size: 1.1rem;
            }

            .countdown-text {
                font-size: 0.95rem;
            }

            .error-buttons {
                gap: 1rem;
            }

            .error-btn {
                padding: 0.9rem 1.8rem;
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="error-page">
       
        
        <div class="error-code">404</div>
        
        <h1 class="error-title">Page Not Found</h1>
        
        <p class="error-desc">
            This is somewhat embarrassing, isn't it? It looks like nothing was found at this location. Maybe try a search?
        </p>

        <!-- 倒计时提示文字 -->
        <p class="countdown-text">
            The page will automatically redirect to the homepage in <strong id="countdown">5</strong> seconds...
        </p>
        
        <div class="error-buttons">
            <a href="/" class="error-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Homepage
            </a>
            <a href="/contact" class="error-btn">
                <i class="fa-solid fa-comment"></i>
                Contact Us
            </a>
        </div>
    </div>

    <script>
        // 倒计时跳转逻辑
        let countdown = 5; // 倒计时秒数
        const countdownEl = document.getElementById('countdown');
        const homepageUrl = '/'; // 跳转地址

        // 每秒更新倒计时
        const timer = setInterval(function() {
            countdown--;
            countdownEl.textContent = countdown;

            if (countdown <= 0) {
                clearInterval(timer);
                window.location.href = homepageUrl;
            }
        }, 1000);

        // 点击按钮后取消自动跳转（防止重复跳转）
        document.querySelectorAll('.error-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                clearInterval(timer);
            });
        });
    </script>
</body>
</html>